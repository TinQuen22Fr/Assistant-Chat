# Image du backend Gemini Perso (utilisée par docker-compose.yml)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/backend

COPY backend/requirements-selfhost.txt ./
RUN pip install --no-cache-dir -r requirements-selfhost.txt

COPY backend/ ./
COPY DEPLOIEMENT.md /app/DEPLOIEMENT.md
COPY deploy/ /app/deploy/

RUN useradd --system --home /app gemini && mkdir -p /data/files && chown -R gemini /data /app/backend
USER gemini

EXPOSE 8001
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--proxy-headers", "--forwarded-allow-ips=*"]
